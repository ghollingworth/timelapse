#!/usr/bin/make -f

# See debhelper(7) (uncomment to enable)
# output every command that modifies files on the build system.
export DH_VERBOSE = 1

%:
	dh $@

# Update paths in the Python files for system installation
override_dh_auto_build:
	# Update config.py to use system paths
	sed -i '/def __init__(self, config_file=.*):$$/,+1c\    def __init__(self, config_file=None):\
        if config_file is None:\
            # Use system config path if running as service, otherwise local\
            if os.path.exists("/var/lib/timelapse"):\
                config_file = "/var/lib/timelapse/config/timelapse_config.json"\
            else:\
                config_file = "timelapse_config.json"' config.py
	
	# Update app.py to use system paths
	sed -i '/^IMAGES_DIR = /c\# Constants - Use system paths if available, otherwise local\
if os.path.exists("/var/lib/timelapse"):\
    IMAGES_DIR = "/var/lib/timelapse/images"\
    VIDEOS_DIR = "/var/lib/timelapse/videos"\
else:\
    IMAGES_DIR = "static/images"\
    VIDEOS_DIR = "static/videos"' app.py
	
	# Update camera.py to use system paths
	sed -i 's/images_dir: str = .*/images_dir: str = None):/' camera.py
	sed -i '/# Ensure directory exists/i\        # Use system path if available, otherwise local\
        if images_dir is None:\
            if os.path.exists("/var/lib/timelapse"):\
                images_dir = "/var/lib/timelapse/images"\
            else:\
                images_dir = "static/images"' camera.py

# Skip tests for now (no tests implemented yet)
override_dh_auto_test:

# Custom installation rules
override_dh_auto_install:
	# Install application files
	install -d debian/timelapse-controller/opt/timelapse
	install -m 644 *.py debian/timelapse-controller/opt/timelapse/
	chmod 755 debian/timelapse-controller/opt/timelapse/video_generator.py
	cp -r templates debian/timelapse-controller/opt/timelapse/
	# Install static directory structure but exclude any generated videos/images
	install -d debian/timelapse-controller/opt/timelapse/static/images
	install -d debian/timelapse-controller/opt/timelapse/static/videos
	touch debian/timelapse-controller/opt/timelapse/static/images/.keep
	touch debian/timelapse-controller/opt/timelapse/static/videos/.keep
	
	# Install WSGI file for Apache (executable)
	install -m 755 timelapse.wsgi debian/timelapse-controller/opt/timelapse/
	
	# Install Apache site configuration
	install -m 644 debian/timelapse-apache.conf debian/timelapse-controller/opt/timelapse/
	
	# Install systemd service
	install -d debian/timelapse-controller/usr/lib/systemd/system
	install -m 644 debian/timelapse.service debian/timelapse-controller/usr/lib/systemd/system/
	
	
	
	# Install lintian overrides
	install -d debian/timelapse-controller/usr/share/lintian/overrides
	install -m 644 debian/lintian-overrides debian/timelapse-controller/usr/share/lintian/overrides/timelapse-controller
	
	# Create data directories
	install -d debian/timelapse-controller/var/lib/timelapse/{images,videos,config}
